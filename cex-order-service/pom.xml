<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.cex</groupId>
        <artifactId>cex-ai</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>cex-order-service</artifactId>
    <name>cex-order-service</name>
    <description>订单服务：订单管理、本地事务 + Outbox 事件发布、订单状态流转</description>

    <dependencies>
        <dependency>
            <groupId>com.cex</groupId>
            <artifactId>cex-common-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cex</groupId>
            <artifactId>cex-common-mysql</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cex</groupId>
            <artifactId>cex-common-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cex</groupId>
            <artifactId>cex-common-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cex</groupId>
            <artifactId>cex-common-dubbo</artifactId>
        </dependency>
        <!--
            ShardingSphere-JDBC 分库分表：订单表数据量大，按需启用
            1. 取消 cex-common-mysql/pom.xml 中 shardingsphere starter 的注释
            2. 启用本依赖
            3. 配置 application.yml 中的 spring.shardingsphere.*（见注释示例）
            <dependency>
                <groupId>org.apache.shardingsphere</groupId>
                <artifactId>shardingsphere-jdbc-spring-boot-starter</artifactId>
            </dependency>
        -->
        <!-- 单元测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        版本兼容矩阵（官方验证组合）：
        Java 17 + Spring Boot 3.3.x + Spring Cloud 2023.0.x (Leyton) + Spring Cloud Alibaba 2023.0.1.0 + Nacos 2.3.2
        Dubbo 3.3.x (Triple 协议) + MyBatis-Plus 3.5.7 + ShardingSphere-JDBC 5.5.0（按需启用）
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.cex</groupId>
    <artifactId>cex-ai</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>cex-ai</name>
    <description>Web3 中心化交易所 (CEX) 微服务平台</description>

    <modules>
        <module>cex-common</module>
        <module>cex-gateway</module>
        <module>cex-user-service</module>
        <module>cex-order-service</module>
        <module>cex-asset-service</module>
        <module>cex-matching-engine</module>
        <module>cex-clearing-service</module>
        <module>cex-market-service</module>
        <module>cex-notification-service</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Spring 生态版本（官方兼容矩阵） -->
        <spring-cloud.version>2023.0.3</spring-cloud.version>
        <spring-cloud-alibaba.version>2023.0.1.0</spring-cloud-alibaba.version>

        <!-- 业务组件版本 -->
        <dubbo.version>3.3.2</dubbo.version>
        <mybatis-plus.version>3.5.7</mybatis-plus.version>
        <shardingsphere.version>5.5.0</shardingsphere.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Cloud BOM（Leyton，兼容 Spring Boot 3.3.x） -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Spring Cloud Alibaba BOM（内置 Nacos client 2.3.2，与服务端 2.3.2 匹配） -->
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Apache Dubbo（Triple 协议，注册中心 Nacos） -->
            <dependency>
                <groupId>org.apache.dubbo</groupId>
                <artifactId>dubbo-spring-boot-starter</artifactId>
                <version>${dubbo.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.dubbo</groupId>
                <artifactId>dubbo-registry-nacos</artifactId>
                <version>${dubbo.version}</version>
            </dependency>
            <!-- MyBatis-Plus（Spring Boot 3 专用 starter） -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!-- ShardingSphere-JDBC 分库分表（按需启用：取消服务 pom 中的注释依赖） -->
            <dependency>
                <groupId>org.apache.shardingsphere</groupId>
                <artifactId>shardingsphere-jdbc-spring-boot-starter</artifactId>
                <version>${shardingsphere.version}</version>
            </dependency>

            <!-- 内部模块统一版本 -->
            <dependency>
                <groupId>com.cex</groupId>
                <artifactId>cex-common-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.cex</groupId>
                <artifactId>cex-common-web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.cex</groupId>
                <artifactId>cex-common-redis</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.cex</groupId>
                <artifactId>cex-common-mysql</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.cex</groupId>
                <artifactId>cex-common-kafka</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.cex</groupId>
                <artifactId>cex-common-dubbo</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- 全局公共依赖：Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <excludes>
                            <exclude>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </exclude>
                        </excludes>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
